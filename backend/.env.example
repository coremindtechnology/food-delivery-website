PORT=5000
NODE_ENV=development

# MongoDB Atlas Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/commercial_food_hub?retryWrites=true&w=majority

# Client URLs (CORS)
FRONTEND_URL=http://localhost:3000

# JWT Secrets
JWT_SECRET=super_secret_jwt_access_token_key_change_me
ADMIN_JWT_SECRET=super_secret_admin_jwt_key_change_me

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret_here

# SMS OTP Provider (e.g. Fast2SMS / Twilio)
SMS_API_KEY=your_sms_provider_api_key
SMS_SENDER_ID=DKITCH


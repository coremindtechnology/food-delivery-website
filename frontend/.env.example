# ─────────────────────────────────────────────────────────────────────────────
# Food Ordering Platform — Frontend Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# 1. Copy this file:  cp .env.example .env.local
# 2. Fill in every placeholder value.
# 3. NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Connection string from Atlas → Connect → Drivers
# Replace <username>, <password>, <cluster>, and <AppName>
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/commercial_food_hub?retryWrites=true&w=majority&appName=<AppName>

# ── JWT / Session Secrets (server-side only) ──────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_at_least_64_random_hex_characters
ADMIN_JWT_SECRET=replace_with_a_different_64_random_hex_characters

# ── Razorpay (server-side keys — NEVER expose to browser) ────────────────────
# Get from: https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── SMS OTP Provider ──────────────────────────────────────────────────────────
# Supported: Fast2SMS, MSG91, Twilio, etc. Fill the key for your chosen provider.
SMS_API_KEY=your_sms_provider_api_key
SMS_SENDER_ID=FOODKT
SMS_TEMPLATE_ID=your_otp_template_id

# ── Admin TOTP (for TOTP authenticator app MFA) ───────────────────────────────
# This is the issuer label shown in apps like Google Authenticator / Authy
TOTP_ISSUER=SampleClientKitchenAdmin

# ── Next.js Public Variables (safe to expose to the browser) ─────────────────
# Only the Razorpay publishable key belongs here — all secrets stay server-side
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_SITE_NAME=Dual Kitchens
NEXT_PUBLIC_VEG_RESTAURANT_NAME=Sample Client Pure Veg Kitchen
NEXT_PUBLIC_NON_VEG_RESTAURANT_NAME=Sample Client Non-Veg Grill & Curries

# ── Application URLs ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# For production, set this to your actual domain:
# NEXT_PUBLIC_APP_URL=https://yourdomain.com

# ── Optional: Node environment ────────────────────────────────────────────────
NODE_ENV=development
